   <string notr="true">
QMainWindow, QWidget {
    background-color: #f3f6fb;
    color: #0f172a;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    font-size: 13px;
}

/* ── Toolbar bar ── */
QWidget#widget_2 {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff,
        stop:1 #eef3f9);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
}

/* ── Nav buttons (back / forward / refresh) ── */
QPushButton#back, QPushButton#refresh, QPushButton#forward {
    background: rgba(15, 23, 42, 0.04);
    border: 1px solid rgba(15, 23, 42, 0.08);
    border-radius: 9px;
    margin: 0 3px;
    color: #1e293b;
}

QPushButton#back:hover, QPushButton#refresh:hover, QPushButton#forward:hover {
    background: rgba(59, 130, 246, 0.10);
    border-color: rgba(59, 130, 246, 0.25);
}

QPushButton#back:pressed, QPushButton#refresh:pressed, QPushButton#forward:pressed {
    background: rgba(59, 130, 246, 0.18);
    border-color: rgba(59, 130, 246, 0.4);
}

/* ── URL bar ── */
QLineEdit#urlbar {
    background: rgba(255, 255, 255, 0.9);
    border: 1.5px solid rgba(148, 163, 184, 0.55);
    border-radius: 20px;
    color: #111827;
    font-size: 13px;
    font-family: "Segoe UI", sans-serif;
    padding: 0 16px;
    selection-background-color: #3b82f6;
}

QLineEdit#urlbar:focus {
    border-color: #3b82f6;
    background: #ffffff;
    color: #0f172a;
}

/* ── Search (go) button ── */
QPushButton#urlbutton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #3b82f6, stop:1 #6d28d9);
    border: none;
    border-radius: 9px;
    margin-left: 6px;
    color: #ffffff;
}

QPushButton#urlbutton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #2563eb, stop:1 #5b21b6);
}

QPushButton#urlbutton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #1d4ed8, stop:1 #4c1d95);
}

/* ── Window controls (minimize / maximize / close) ── */
QPushButton#redius, QPushButton#full, QPushButton#close_button {
    border-radius: 50%;
    border: none;
}

QPushButton#redius {
    background: rgba(234, 179, 8, 0.15);
    border: 1.5px solid rgba(234, 179, 8, 0.3);
}

QPushButton#redius:hover {
    background: #f59e0b;
    border-color: #f59e0b;
}

QPushButton#full {
    background: rgba(34, 197, 94, 0.15);
    border: 1.5px solid rgba(34, 197, 94, 0.3);
}

QPushButton#full:hover {
    background: #22c55e;
    border-color: #22c55e;
}

QPushButton#close_button {
    background: rgba(239, 68, 68, 0.15);
    border: 1.5px solid rgba(239, 68, 68, 0.3);
}

QPushButton#close_button:hover {
    background: #ef4444;
    border-color: #ef4444;
}

QPushButton#close_button:pressed {
    background: #dc2626;
}

/* ── Scrollbars ── */
QScrollBar:vertical {
    background: #edf2f7;
    width: 7px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: rgba(15, 23, 42, 0.18);
    border-radius: 4px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(59, 130, 246, 0.45);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #edf2f7;
    height: 7px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: rgba(15, 23, 42, 0.18);
    border-radius: 4px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(59, 130, 246, 0.45);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
   </string>
